/* pages/queen/queen-theme.wxss —— 蒸汽朋克/柴油朋克 公共主题 */

/* 调色板
   铁灰底 #1a1c20 ~ #23252b
   黄铜    #b08d57 / #caa46a / #d8bd86
   暗钢    #3a3d44 / #50545d
   危险红  #a83232
   声望色  红 #c0392b / 黄 #d4a017 / 蓝 #2e6f9e
*/

.qpage {
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 0%, rgba(176,141,87,0.10), transparent 40%),
    radial-gradient(circle at 90% 100%, rgba(80,84,93,0.18), transparent 45%),
    linear-gradient(160deg, #23252b 0%, #1a1c20 55%, #15161a 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  color: #d8bd86;
  position: relative;
}
/* 金属划痕质感 */
.qpage::before {
  content: '';
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image:
    repeating-linear-gradient(115deg, rgba(255,255,255,0.015) 0 2rpx, transparent 2rpx 7rpx),
    repeating-linear-gradient(60deg, rgba(0,0,0,0.06) 0 1rpx, transparent 1rpx 5rpx);
  pointer-events: none;
  z-index: 0;
}

/* 自定义导航栏 */
.qnav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
  position: relative;
  z-index: 2;
  border-bottom: 1rpx solid rgba(176,141,87,0.25);
  background: linear-gradient(180deg, rgba(35,37,43,0.9), rgba(26,28,32,0.6));
}
.qnav-back {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; color: #caa46a; line-height: 1;
}
.qnav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  letter-spacing: 6rpx;
  font-weight: bold;
  color: #d8bd86;
  text-shadow: 0 2rpx 0 rgba(0,0,0,0.5);
}
.qnav-spacer { width: 64rpx; }

.qbody { flex: 1; position: relative; z-index: 1; height: 0; }

.safe-pad { height: calc(40rpx + env(safe-area-inset-bottom)); }

/* 黄铜主按钮 */
.btn-brass {
  background: linear-gradient(180deg, #d8bd86 0%, #b08d57 55%, #8a6a3c 100%);
  color: #2a1f10;
  border: 1rpx solid #e3cf9c;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 0 #5e472a, 0 8rpx 16rpx rgba(0,0,0,0.4);
  display: flex;
  align-items: center;    /* 垂直居中 */
  justify-content: center;/* 水平居中 */
  height: 92rpx;
}
.btn-brass::after { border: none; }
.btn-brass.is-loading { opacity: 0.6; }
.btn-gear { display: inline-block; }

/* 暗钢次按钮 */
.btn-iron {
  background: linear-gradient(180deg, #50545d, #34373d);
  color: #d8bd86;
  border: 1rpx solid rgba(176,141,87,0.4);
  border-radius: 10rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  height: 80rpx;
  padding: 0 36rpx;
}
.btn-iron::after { border: none; }
.btn-iron.is-loading { opacity: 0.6; }

/* 面板 */
.panel {
  margin: 28rpx 36rpx 0;
  padding: 28rpx;
  background: linear-gradient(180deg, rgba(58,61,68,0.55), rgba(30,32,37,0.55));
  border: 1rpx solid rgba(176,141,87,0.25);
  border-radius: 16rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.04);
}
.panel-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #8a7a55;
  margin-bottom: 20rpx;
  text-transform: uppercase;
}

scroll-view ::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
  background: transparent;
}
