/* pages/queen/game/game.wxss */
@import "../queen-theme.wxss";

.game-page { height: 100vh; overflow: hidden; }
.help-icon {
  display: inline-block; width: 48rpx; height: 48rpx; line-height: 44rpx;
  text-align: center; border: 2rpx solid #b08d57; border-radius: 50%;
  color: #e3cf9c; font-size: 30rpx; font-weight: bold;
  background: rgba(176,141,87,0.15);
  box-shadow: 0 0 10rpx rgba(176,141,87,0.3);
}
.qnav-spacer { display: flex; align-items: center; justify-content: center; }
.loading { flex: 1; display: flex; align-items: center; justify-content: center; color: #8a7a55; font-size: 28rpx; position: relative; z-index: 1; }

.game-body {
  flex: 1; position: relative; z-index: 1;
  display: flex; flex-direction: column;
  padding: 10rpx 0 0; min-height: 0;
}

/* 声望条 */
.prestige-bar {
  display: flex; align-items: center;
  padding: 12rpx 20rpx;
  margin: 0 16rpx;
  background: rgba(0,0,0,0.28);
  border: 1rpx solid rgba(176,141,87,0.22);
  border-radius: 12rpx;
}
.opp-bar { margin-top: 8rpx; }
.my-bar { margin-top: 10rpx; }
.side-tag { font-size: 22rpx; color: #9c8a64; width: 150rpx; letter-spacing: 1rpx; }
.tokens { flex: 1; display: flex; gap: 12rpx; justify-content: center; }
.token {
  font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx;
  color: #eee; border: 1rpx solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.05);
}
.token.done { box-shadow: 0 0 12rpx currentColor; font-weight: bold; }
.p-red { color: #e8736a; border-color: rgba(192,57,43,0.6); background: rgba(192,57,43,0.18); }
.p-yellow { color: #e8c45a; border-color: rgba(212,160,23,0.6); background: rgba(212,160,23,0.16); }
.p-blue { color: #6fb0d8; border-color: rgba(46,111,158,0.6); background: rgba(46,111,158,0.18); }

.master-mini { display: flex; align-items: center; gap: 8rpx; width: 90rpx; justify-content: flex-end; }
.master-label { font-size: 20rpx; color: #8a7a55; }
.mini-tile {
  width: 48rpx; height: 60rpx; border-radius: 6rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  background: linear-gradient(180deg,#3a3d44,#23252b);
  border: 1rpx solid rgba(176,141,87,0.4);
}
.mini-tile.back { color: #6a6452; }

/* 棋盘 */
.board-scroll { flex: 1; min-height: 0; white-space: nowrap; margin-top: 10rpx; }
.board { display: inline-flex; padding: 10rpx 16rpx; gap: 10rpx; }
.col {
  display: flex; flex-direction: column; align-items: center;
  border-radius: 12rpx; padding: 8rpx 6rpx;
}
.col-active { background: rgba(176,141,87,0.14); box-shadow: inset 0 0 0 1rpx rgba(216,189,134,0.5); }
.col-princess .num { color: #e8736a; border-color: rgba(168,50,50,0.7); }

/* 牌 */
.tile {
  width: 120rpx; height: 156rpx;
  border-radius: 12rpx;
  background: linear-gradient(165deg, #3f424a 0%, #2a2c31 60%, #202227 100%);
  border: 1rpx solid rgba(176,141,87,0.4);
  box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.4), inset 0 1rpx 0 rgba(255,255,255,0.05);
  position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.tile-back {
  background:
    repeating-linear-gradient(45deg, rgba(176,141,87,0.08) 0 6rpx, transparent 6rpx 12rpx),
    linear-gradient(165deg, #2f323a, #1d1f24);
}
.tile-peek {
  border-style: dashed;
  border-color: rgba(216,189,134,0.7);
  background: linear-gradient(165deg, #4a4133 0%, #322a1e 60%, #241d12 100%);
}
.tile-selected { box-shadow: 0 0 0 3rpx #e3cf9c, 0 3rpx 8rpx rgba(0,0,0,0.4); }
.tile-init {
  position: absolute; top: 6rpx; left: 8rpx;
  font-size: 22rpx; font-weight: bold; color: #d8bd86;
  width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center;
  background: rgba(0,0,0,0.4); border-radius: 50%; border: 1rpx solid rgba(176,141,87,0.5);
}
.tile-emoji { font-size: 58rpx; line-height: 1; }
.tile-name { font-size: 22rpx; color: #cbb98e; margin-top: 8rpx; letter-spacing: 1rpx; }
.back-face { font-size: 50rpx; opacity: 0.45; }
.peek-tag {
  position: absolute; top: 4rpx; right: 4rpx;
  font-size: 16rpx; color: #2a1f10; background: #d8bd86;
  padding: 1rpx 6rpx; border-radius: 5rpx; line-height: 1.4;
  font-weight: bold;
}
.opp-tile.p-red, .my-tile.p-red { border-color: rgba(192,57,43,0.55); }
.opp-tile.p-yellow, .my-tile.p-yellow { border-color: rgba(212,160,23,0.55); }
.opp-tile.p-blue, .my-tile.p-blue { border-color: rgba(46,111,158,0.55); }

.num {
  width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center;
  margin: 8rpx 0;
  font-size: 28rpx; font-weight: bold; color: #b08d57;
  border: 2rpx solid rgba(176,141,87,0.5); border-radius: 50%;
  background: rgba(0,0,0,0.3);
}
.num-active { color: #2a1f10; background: linear-gradient(180deg,#e3cf9c,#b08d57); border-color: #e3cf9c; }

/* 状态/骰子 */
.status-bar { display: flex; justify-content: center; align-items: center; padding: 12rpx; min-height: 60rpx; }
.dice-box { display: flex; align-items: center; gap: 14rpx; }
.die {
  width: 60rpx; height: 60rpx; line-height: 60rpx; text-align: center;
  background: linear-gradient(160deg,#e8e6e0,#bdbab2); color: #23252b;
  border-radius: 10rpx; font-size: 34rpx; font-weight: bold;
  box-shadow: 0 3rpx 6rpx rgba(0,0,0,0.5);
}
.dice-sum { font-size: 26rpx; color: #d8bd86; margin-left: 6rpx; }
.turn-hint { font-size: 28rpx; color: #caa46a; letter-spacing: 2rpx; }

/* 操作区 */
.action-zone { padding: 6rpx 36rpx; }
.act-btn { width: 100%; }
.wait-text { text-align: center; color: #8a7a55; font-size: 26rpx; padding: 16rpx 0; }
.repo-tools { display: flex; gap: 20rpx; margin-bottom: 14rpx; }
.repo-btn { flex: 1; }
.repo-btn.active { background: linear-gradient(180deg,#d8bd86,#b08d57); color: #2a1f10; }
.repo-tip { text-align: center; font-size: 24rpx; color: #9c8a64; margin-bottom: 14rpx; }

/* 日志 */
.log-box {
  margin: 8rpx 24rpx 0; padding: 12rpx 18rpx;
  background: rgba(0,0,0,0.25); border-radius: 10rpx;
  border: 1rpx solid rgba(176,141,87,0.15);
  max-height: 150rpx;
}
.log-line { font-size: 22rpx; color: #8d7f5e; line-height: 1.6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.bottom-actions { text-align: center; padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom)); }
.surrender { font-size: 24rpx; color: #6f6750; text-decoration: underline; }

/* 弹层 */
.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 50;
  background: rgba(0,0,0,0.6);
  display: flex; align-items: center; justify-content: center;
}
.modal {
  width: 78%;
  background: linear-gradient(180deg, #34373d, #23252b);
  border: 1rpx solid rgba(176,141,87,0.5);
  border-radius: 18rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.6);
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 28rpx;
}
.modal-title { font-size: 30rpx; color: #e3cf9c; flex: 1; text-align: center; letter-spacing: 1rpx; }
.modal-minimize-btn {
  width: 50rpx; height: 50rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; border-radius: 8rpx;
  border: 1rpx solid rgba(176,141,87,0.4); 
  background: rgba(176,141,87,0.1);
}
.minimize-icon { font-size: 28rpx; color: #caa46a; font-weight: 700; line-height: 1;
transform: translateY(-2rpx); }
.opt-row { display: flex; gap: 18rpx; justify-content: center; }
.opt-color {
  flex: 1; text-align: center; padding: 24rpx 0; border-radius: 12rpx;
  font-size: 28rpx; font-weight: bold; border: 1rpx solid;
}
.opt-list { display: flex; flex-direction: column; gap: 14rpx; }
.opt-item {
  padding: 22rpx; text-align: center; font-size: 28rpx; color: #d8bd86;
  background: rgba(0,0,0,0.3); border: 1rpx solid rgba(176,141,87,0.3); border-radius: 10rpx;
}
.opt-item:active { background: rgba(176,141,87,0.15); }
.skip-btn { width: 100%; margin-top: 24rpx; }

/* 决策悬浮气泡（最小化状态） */
.decision-bubble {
  position: fixed; bottom: calc(120rpx + env(safe-area-inset-bottom)); right: 24rpx;
  z-index: 50;
  display: flex; align-items: center; gap: 12rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #3a3d44, #23252b);
  border: 2rpx solid rgba(216,189,134,0.7);
  border-radius: 50rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.6), 0 0 0 1rpx rgba(176,141,87,0.3);
  max-width: 360rpx;
}
.bubble-icon { font-size: 34rpx; flex-shrink: 0; }
.bubble-text {
  flex: 1; min-width: 0;
  font-size: 24rpx; color: #e3cf9c; letter-spacing: 1rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.bubble-expand {
  flex-shrink: 0;
  font-size: 22rpx; color: #b08d57;
  border: 1rpx solid rgba(176,141,87,0.5); border-radius: 20rpx;
  padding: 4rpx 14rpx;
  background: rgba(176,141,87,0.1);
}

.result-modal { text-align: center; }
.result-rose { font-size: 100rpx; line-height: 1; margin-bottom: 16rpx; }
.result-text { font-size: 34rpx; color: #e3cf9c; margin-bottom: 36rpx; letter-spacing: 2rpx; }

/* 规则弹层 */
.rules-modal {
  width: 86%;
  height: 78vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #2f323a, #1f2126);
  border: 1rpx solid rgba(176,141,87,0.5);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.7);
  overflow: hidden;
}
.rules-head {
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid rgba(176,141,87,0.3);
  background: linear-gradient(180deg, rgba(176,141,87,0.18), transparent);
}
.rules-title { font-size: 32rpx; font-weight: bold; color: #e3cf9c; letter-spacing: 2rpx; }
.rules-close {
  width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  font-size: 32rpx; color: #caa46a;
  border: 1rpx solid rgba(176,141,87,0.4); border-radius: 50%;
}
.rules-scroll {
  flex: 1;
  min-height: 0;
  height: 1px;          /* 触发 flex:1 在 scroll-view 上正确撑开并可滚动 */
  box-sizing: border-box;
  padding: 10rpx 28rpx;
}

.rules-sec { padding: 20rpx 0; border-bottom: 1rpx dashed rgba(176,141,87,0.18); }
.rules-sec:last-child { border-bottom: none; }
.rules-h { font-size: 28rpx; font-weight: bold; color: #d8bd86; margin-bottom: 14rpx; letter-spacing: 1rpx; }
.rules-p { font-size: 25rpx; color: #b3a47c; line-height: 1.7; margin-bottom: 8rpx; }
.rules-li { font-size: 25rpx; color: #a89971; line-height: 1.75; margin-bottom: 8rpx; }
.rules-sub { font-size: 24rpx; color: #8d7f5e; line-height: 1.7; padding-left: 24rpx; margin-top: 4rpx; }
.hl { color: #e3cf9c; }
.dim { color: #7a6f52; font-size: 23rpx; }

.rules-role {
  display: flex; align-items: baseline;
  font-size: 24rpx; line-height: 1.6; margin-bottom: 14rpx;
}
.r-emoji { width: 44rpx; font-size: 30rpx; flex-shrink: 0; }
.r-name { width: 120rpx; color: #d8bd86; flex-shrink: 0; }
.r-desc { flex: 1; min-width: 0; color: #a89971; word-break: break-word; }

.rules-foot { text-align: center; font-size: 22rpx; color: #6f6750; padding: 24rpx 0; }
