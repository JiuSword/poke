/* pages/queen/room/room.wxss */
@import "../queen-theme.wxss";

.codebar {
  margin: 30rpx 36rpx 0;
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  background: rgba(0,0,0,0.3);
  border: 1rpx solid rgba(176,141,87,0.3);
  border-radius: 12rpx;
}
.codebar-label { font-size: 24rpx; color: #8a7a55; letter-spacing: 2rpx; }
.codebar-code {
  flex: 1; text-align: center;
  font-size: 48rpx; font-weight: bold; letter-spacing: 10rpx;
  color: #e3cf9c; text-shadow: 0 2rpx 0 rgba(0,0,0,0.5);
}
.codebar-copy { font-size: 26rpx; color: #caa46a; }

.versus {
  margin: 40rpx 36rpx 0;
  display: flex;
  gap: 24rpx;
  position: relative;
}
.seat {
  flex: 1;
  border-radius: 18rpx;
  padding: 36rpx 18rpx 26rpx;
  display: flex; flex-direction: column; align-items: center;
  border: 1rpx solid rgba(176,141,87,0.3);
  background: linear-gradient(180deg, rgba(58,61,68,0.5), rgba(26,28,32,0.5));
}
.seat-white { box-shadow: inset 0 0 30rpx rgba(230,230,230,0.07); }
.seat-black { box-shadow: inset 0 0 30rpx rgba(0,0,0,0.4); }
.seat-empty { justify-content: center; opacity: 0.7; }
.seat-rose { font-size: 50rpx; line-height: 1; margin-bottom: 14rpx; }
.seat-avatar {
  width: 130rpx; height: 130rpx; border-radius: 50%;
  border: 3rpx solid #b08d57; background: #2a2c31;
}
.seat-name { margin-top: 18rpx; font-size: 30rpx; color: #e3cf9c; font-weight: bold; }
.seat-color { margin-top: 6rpx; font-size: 24rpx; color: #9c8a64; letter-spacing: 2rpx; }
.seat-ready {
  margin-top: 18rpx;
  font-size: 24rpx; padding: 6rpx 22rpx; border-radius: 30rpx;
  color: #9c8a64; border: 1rpx solid rgba(156,138,100,0.4);
}
.seat-ready.is-ready { color: #2a1f10; background: linear-gradient(180deg,#d8bd86,#b08d57); border-color: #e3cf9c; font-weight: bold; }
.seat-waiting { font-size: 28rpx; color: #9c8a64; margin-top: 10rpx; }
.seat-hint { font-size: 22rpx; color: #6f6750; margin-top: 12rpx; }

.vs-badge {
  text-align: center;
  margin-top: 24rpx;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: #a83232;
  font-weight: bold;
  text-shadow: 0 0 12rpx rgba(168,50,50,0.5);
}

.room-actions {
  margin: 36rpx 36rpx 0;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.ready-btn { width: 100%; }
.ready-btn.readied { background: linear-gradient(180deg, #6b4a4a, #463232); }
.start-btn { width: 100%; }
.share-btn { width: 100%; }

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #6f6750;
  margin-top: 30rpx;
}
