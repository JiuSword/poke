/* pages/home/home.wxss */
.container {
  padding: 32rpx 64rpx 100rpx;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.loading-area {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-text {
  font-size: 30rpx;
  color: rgba(255,255,255,0.5);
}

.user-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 32rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  border: 3rpx solid rgba(255,215,0,0.5);
  flex-shrink: 0;
}

.user-info { flex: 1; }

.nickname {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 10rpx;
}

.points-row { display: flex; align-items: center; }

.points-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-right: 12rpx;
}

.points-value {
  font-size: 34rpx;
  font-weight: bold;
}

/* 内容区：撑满剩余空间 */
.content-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 菜单格子：撑满剩余空间 */
.menu-grid {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 36rpx;
}

/* 横置入口：双人桌游（蒸汽朋克金属风，区别于上方宫格） */
.menu-banner {
  flex-shrink: 0;
  margin-top: 36rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 12% 30%, rgba(176,141,87,0.25), transparent 45%),
    linear-gradient(135deg, #3a3d44 0%, #23252b 60%, #1a1c20 100%);
  border: 1rpx solid rgba(176,141,87,0.45);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.06), 0 6rpx 18rpx rgba(0,0,0,0.4);
  position: relative;
  overflow: hidden;
}
.menu-banner::after {
  content: '';
  position: absolute; right: -40rpx; top: -40rpx;
  width: 200rpx; height: 200rpx;
  background: repeating-conic-gradient(rgba(176,141,87,0.10) 0deg 12deg, transparent 12deg 24deg);
  border-radius: 50%;
}
.menu-banner:active { background: linear-gradient(135deg, #45484f, #2a2c31); }
.banner-left {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.3);
  border: 2rpx solid rgba(176,141,87,0.5);
  flex-shrink: 0;
}
.banner-rose { font-size: 56rpx; line-height: 1; }
.banner-mid { flex: 1; margin-left: 28rpx; display: flex; flex-direction: column; }
.banner-title {
  font-size: 34rpx; font-weight: bold; color: #e3cf9c;
  letter-spacing: 2rpx; text-shadow: 0 2rpx 0 rgba(0,0,0,0.5);
}
.banner-desc { font-size: 24rpx; color: #9c8a64; margin-top: 10rpx; }
.banner-arrow { font-size: 56rpx; color: #b08d57; position: relative; z-index: 1; }

.menu-item {
  background: rgba(255,255,255,0.08);
  border-radius: 28rpx;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.menu-item:active {
  background: rgba(255,255,255,0.15);
}

.menu-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.menu-label {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
}
